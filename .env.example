# ChronosWork — Variables de Entorno
# Renombra este archivo a .env y completa los valores reales.

# URL de tu proyecto Supabase (Settings > API > Project URL)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima de Supabase (Settings > API > Project API keys > anon public)
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui
